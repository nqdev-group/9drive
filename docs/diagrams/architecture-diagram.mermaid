graph TB
    subgraph Client["Client"]
        FE["frontend/ (React 19 + Vite)<br/>ProtectedRoute + DriveLayout"]
    end

    subgraph Server["backend/ (Express 5 + TypeScript)"]
        APP["app.ts<br/>middleware + router mounting"]
        AUTH["auth / requireAuth<br/>JWT bearer + refresh"]
        APIKEY["requireApiKey<br/>external upload auth"]
        MODULES["src/modules/*<br/>files, uploads, folders,<br/>connected-accounts, storage,<br/>invites, api-keys, system"]
    end

    subgraph Data["Persistence"]
        MYSQL[("MySQL 8<br/>via Prisma 6<br/>users, files, folders,<br/>accounts, quotas, invites")]
    end

    subgraph Providers["Storage Providers"]
        GDRIVE["Google Drive API<br/>(googleapis, OAuth2)<br/>root folder: 9drive"]
        S3["S3-compatible storage<br/>(@aws-sdk/client-s3)<br/>AWS S3 / R2 / MinIO / Wasabi / B2"]
    end

    subgraph External["External Integrations"]
        RECAPTCHA["Google reCAPTCHA<br/>(optional, register only)"]
        EXTSYS["External systems<br/>(scripts, backup jobs)"]
    end

    FE -->|"HTTPS JSON + multipart<br/>Authorization: Bearer <JWT>"| APP
    EXTSYS -->|"Authorization: Bearer <API key>"| APIKEY
    APIKEY --> MODULES
    APP --> AUTH --> MODULES
    MODULES -->|Prisma ORM| MYSQL
    MODULES -->|"stream upload/download<br/>(undici, googleapis)"| GDRIVE
    MODULES -->|"stream upload/download<br/>(lib-storage, GetObject)"| S3
    MODULES -.->|"siteverify (register only)"| RECAPTCHA
