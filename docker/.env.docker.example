# MySQL (used to build backend's DATABASE_URL)
MYSQL_USER=9drive
MYSQL_PASSWORD=<real-strong-password-here>
MYSQL_DATABASE=9drive
MYSQL_HOST=minipc-quyit
MYSQL_PORT=3306

# Frontend origin backend trusts for CORS + used in Google OAuth email links
FRONTEND_URL=http://<your-actual-public-host-or-ip>:5173

# Must be 32+ chars each — generate real random values, do not reuse the placeholders below
# openssl rand -hex 32
JWT_ACCESS_SECRET=<random-32+-char-secret>
TOKEN_ENCRYPTION_KEY=<random-32-byte-secret>

ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

# Google OAuth (leave blank if not using Google sign-in/Drive connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://<your-actual-public-host-or-ip>:10024/connected-accounts/google/callback

# Optional — only needed if you want captcha on register
RECAPTCHA_SECRET_KEY=

# Optional — logger overrides, defaults are fine (http level, ./logs dir)
LOG_LEVEL=http
LOG_DIR=logs
